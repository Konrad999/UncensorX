{
  "manifest_version": 3,
  "name": "UncensorX",
  "version": "1.0.0",
  "description": "Browse X without restrictions. Removes sensitive content blur and forced age verification prompts.",
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://mobile.twitter.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ]
}
